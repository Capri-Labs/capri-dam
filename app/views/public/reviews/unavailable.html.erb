<%# Shown when a review link is unknown, expired, revoked, or locked behind a
    passphrase. Deliberately plain: an unauthenticated visitor should get a
    clear explanation and nothing about the asset the link pointed at. %>
<% content_for :title, "Review link unavailable — Capri DAM" %>

<div style="max-width:520px; margin:64px auto; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:40px; text-align:center;">
  <% if @denial_reason == :passphrase_required %>
    <h1 style="margin:0 0 8px; font-size:1.25rem; color:#121926;">This review is protected</h1>
    <p style="margin:0 0 24px; color:#64748b; font-size:0.95rem;">
      Enter the passphrase you were given to continue.
    </p>

    <form id="review-unlock-form" style="display:flex; gap:8px; justify-content:center;">
      <input type="password" id="review-passphrase" placeholder="Passphrase" autocomplete="off"
             style="flex:1; max-width:260px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:0.95rem;">
      <button type="submit"
              style="padding:10px 18px; border:0; border-radius:8px; background:#2563eb; color:#fff; font-size:0.95rem; cursor:pointer;">
        Unlock
      </button>
    </form>
    <p id="review-unlock-error" role="alert" style="display:none; margin:16px 0 0; color:#dc2626; font-size:0.875rem;"></p>

    <script>
      (function () {
        var form = document.getElementById('review-unlock-form');
        var error = document.getElementById('review-unlock-error');

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          error.style.display = 'none';

          fetch(window.location.pathname.replace(/\/$/, '') + '/unlock', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ passphrase: document.getElementById('review-passphrase').value })
          })
            .then(function (response) { return response.json().then(function (b) { return { ok: response.ok, body: b }; }); })
            .then(function (result) {
              if (result.ok) { window.location.reload(); return; }
              error.textContent = result.body.error || 'That passphrase is not correct.';
              error.style.display = 'block';
            })
            .catch(function () {
              error.textContent = 'Something went wrong. Please try again.';
              error.style.display = 'block';
            });
        });
      })();
    </script>
  <% else %>
    <h1 style="margin:0 0 8px; font-size:1.25rem; color:#121926;">
      <%= @denial_reason == :expired ? "This review link has expired" : "This review link is unavailable" %>
    </h1>
    <p style="margin:0; color:#64748b; font-size:0.95rem;">
      <% case @denial_reason %>
      <% when :expired %>
        Review links are time-limited. Please ask your contact for a fresh one.
      <% when :revoked %>
        This link has been withdrawn by the team that shared it.
      <% else %>
        Please check the address, or ask your contact to send the link again.
      <% end %>
    </p>
  <% end %>
</div>
